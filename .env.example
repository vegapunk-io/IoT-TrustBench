# IoT-TrustBench Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit real API keys or secrets.

# LLM Configuration (optional — system works fully without an API key)
LLM_BACKEND=local
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash
LLM_BASE_URL=

# Server configuration
HOST=0.0.0.0
PORT=8000

# Database
DB_PATH=iot_trustbench.db
