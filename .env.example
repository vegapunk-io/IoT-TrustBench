# IoT-TrustBench Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit real API keys or secrets.

# LLM Configuration (optional — system works fully without an API key)
LLM_BACKEND=local
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash
LLM_BASE_URL=

# Admin API key for trusted-device management endpoints
# If not set, development mode allows all access without a key.
# Set this in production to protect device registration endpoints.
ADMIN_API_KEY=

# Server configuration
HOST=0.0.0.0
PORT=8000

# Database path (override for testing)
IOT_DB_PATH=iot_trustbench.db
