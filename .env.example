# LLM Configuration
LLM_BACKEND=local
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash
LLM_BASE_URL=
LLM_TIMEOUT=10

# Admin API Key (required for trusted device management and history reset)
ADMIN_KEY=

# CORS Origins (comma-separated, default: *)
CORS_ORIGINS=*

# Database Path (default: iot_trustbench.db)
DB_PATH=iot_trustbench.db
